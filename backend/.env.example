# Copy to `.env` and fill in. NEVER commit `.env` (RULES.md R-15).

# Required — app will refuse to start without these
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
REPORT_HASH_SALT=

# Optional — defaults shown
PORT=3000
CORS_ORIGIN=http://localhost:5173

# OSRM routing engine (RFC-002). Defaults work out-of-the-box against the
# public demo server. For the live demo, run local Docker OSRM with the foot
# profile (runbook in RFC-007) and uncomment:
# OSRM_BASE_URL=http://localhost:5000
# OSRM_PROFILE=foot
# OSRM_TIMEOUT_MS=4000

# RFC-007 Resilience & Deployment
# When true, OSRM failures serve pre-scored static routes instead of 502
STATIC_FALLBACK_ENABLED=true
