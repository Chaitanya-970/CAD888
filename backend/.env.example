# Copy to `.env` and fill in. NEVER commit `.env` (RULES.md R-15).

# Install dependencies first - versions resolve from the registry at install
# time and are pinned by package-lock.json (RULES.md R-01: no versions from memory):
#   npm install express dotenv @supabase/supabase-js pino ngeohash @mapbox/polyline
#   npm install -D jest supertest

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=3000
REPORT_HASH_SALT=
CORS_ORIGIN=http://localhost:5173

# OSRM routing engine (RFC-002). Defaults work out-of-the-box against the
# public demo server. For the live demo, run local Docker OSRM with the foot
# profile (runbook in RFC-007) and uncomment:
# OSRM_BASE_URL=http://localhost:5000
# OSRM_PROFILE=foot
# OSRM_TIMEOUT_MS=4000
