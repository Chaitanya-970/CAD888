index 0000000..04fa993
--- /dev/null
+++ b/backend/src/services/explainAgent.js
@@ -0,0 +1,302 @@
+/**
+ * Role 3 integration — Explainable Safety Agent bridge.
+ *
+ * Turns the grounded factors from RFC-006 (explainContext.js) into the
+ * `signals` contract defined in ai_agent/signal_contract.py, then renders a
+ * 1-2 sentence plain-English explanation.
+ *
+ * Two runtimes, chosen by EXPLAIN_AGENT_MODE:
+ *
+ *   "js"     (default) — renders in-process using the same grounding rules as
+ *                        ai_agent/explain_agent.py's mock/fallback template.
+ *                        Works everywhere, including Vercel serverless.
+ *   "python" —           spawns `python3 ai_agent/explain_agent.py` and pipes
+ *                        JSON over stdin/stdout, per ai_agent/README.md. Gives
+ *                        you real Grok/Gemini output. Requires a host with
+ *                        Python (local dev, Railway, Render, Docker) — NOT
+ *                        Vercel serverless.
+ *   "http"   —           POSTs to the agent deployed as its own Python function
+ *                        (ai_agent/api/index.py + ai_agent/vercel.json). Set
+ *                        EXPLAIN_AGENT_URL to that deployment's URL. This is the
+ *                        one that gives you a real LLM while the backend stays
+ *                        on Vercel.
+ *
+ * Failures are always non-fatal: the caller keeps its base contract and simply
+ * gets no `explanation` field.
+ */
+
+import { execFile } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+/** Repo root — src/services/ → src/ → backend/ → repo root. */
+const REPO_ROOT = path.resolve(__dirname, '..', '..', '..');
+const AGENT_SCRIPT = path.join(REPO_ROOT, 'ai_agent', 'explain_agent.py');
+
+const AGENT_TIMEOUT_MS = Number(process.env.EXPLAIN_AGENT_TIMEOUT_MS || 8000);
+
+/** Default provider for the remote modes. */
+const DEFAULT_PROVIDER = process.env.EXPLAIN_AGENT_PROVIDER || 'mock';
+
+// ── Signal building ──────────────────────────────────────────────────
+
+/**
+ * Pick the worst-scoring cell on the route — the one the explanation is about.
+ *
+ * @param {string[]} cells
+ * @param {Map<string, number>} cellScoreMap
+ * @returns {{ cell: string, score: number }}
+ */
+export function worstCellOf(cells, cellScoreMap) {
+  let cell = cells[0];
+  let score = Infinity;
+  for (const c of cells) {
+    const s = cellScoreMap.get(c) ?? 50;
+    if (s < score) {
+      score = s;
+      cell = c;
+    }
+  }
+  return { cell, score: score === Infinity ? 50 : score };
+}
+
+/**
+ * Build one `signals` object matching ai_agent/signal_contract.py exactly.
+ * Every value comes from the DB or the scoring engine — nothing is invented.
+ *
+ * @param {object} params
+ * @param {string} params.cell - geohash-7 the explanation is about
+ * @param {number} params.score - route score 0-100
+ * @param {string} params.bucket - morning|day|evening|night
+ * @param {string} [params.routeLabel]
+ * @param {object} [deps] - { getDb }
+ * @returns {Promise<object>} signals
+ */
+export async function buildSignals({ cell, score, bucket, routeLabel = 'Route' }, deps = {}) {
+  const getDb = deps.getDb;
+  const db = getDb ? getDb() : (await import('../db/supabase.js')).default();
+
+  // Lighting / foot traffic for the worst cell.
+  let lighting = 50;
+  let footTraffic = 50;
+  try {
+    const { data: seg } = await db
+      .from('road_segments')
+      .select('lighting, foot_traffic')
+      .eq('cell_geohash', cell)
+      .single();
+    if (seg) {
+      lighting = seg.lighting ?? 50;
+      footTraffic = seg.foot_traffic ?? 50;
+    }
+  } catch {
+    /* fall through to neutral defaults */
+  }
+
+  // Recent reports in that cell — severity, light condition, verbatim notes.
+  let reports = [];
+  try {
+    const { data } = await db
+      .from('incident_reports')
+      .select('severity, light_condition, note, occurred_at, reporter_hash')
+      .eq('cell_geohash', cell)
+      .order('occurred_at', { ascending: false })
+      .limit(20);
+    reports = data || [];
+  } catch {
+    reports = [];
+  }
+
+  const incidentSummary = [];
+  let corroborated = false;
+
+  if (reports.length > 0) {
+    const now = Date.now();
+    const daysAgo = reports.map((r) =>
+      Math.floor((now - new Date(r.occurred_at).getTime()) / 86_400_000)
+    );
+    const severities = reports.map((r) => Number(r.severity) || 1);
+
+    // Most common light_condition.
+    const lightCounts = {};
+    for (const r of reports) {
+      const lc = r.light_condition || 'unknown';
+      lightCounts[lc] = (lightCounts[lc] || 0) + 1;
+    }
+    const lightMode = Object.entries(lightCounts).sort((a, b) => b[1] - a[1])[0][0];
+
+    incidentSummary.push({
+      count: reports.length,
+      most_recent_days_ago: Math.min(...daysAgo),
+      severity_avg: Number(
+        (severities.reduce((a, b) => a + b, 0) / severities.length).toFixed(1)
+      ),
+      light_condition_mode: lightMode,
+      sample_notes: reports
+        .map((r) => r.note)
+        .filter((n) => typeof n === 'string' && n.trim() !== '')
+        .slice(0, 3),
+    });
+
+    // Corroborated = >= 2 distinct reporters (matches the scoring engine's rule).
+    const reporters = new Set(reports.map((r) => r.reporter_hash).filter(Boolean));
+    corroborated = reporters.size >= 2 || (reporters.size === 0 && reports.length >= 2);
+  }
+
+  return {
+    segment_id: cell,
+    route_label: routeLabel,
+    time_bucket: bucket,
+    safety_score: score,
+    lighting,
+    foot_traffic: footTraffic,
+    incident_summary: incidentSummary,
+    corroborated,
+  };
+}
+
+// ── Renderer A: in-process JS (Vercel-safe) ──────────────────────────
+
+/**
+ * Port of ai_agent/explain_agent.py's grounded fallback template.
+ * Never names an incident category — the DB has no such field.
+ *
+ * @param {object} s - signals
+ * @returns {string}
+ */
+export function renderExplanationJs(s) {
+  const parts = [];
+  const lightWord = s.lighting < 40 ? 'poorly lit' : s.lighting < 70 ? 'partly lit' : 'well lit';
+  const trafficWord =
+    s.foot_traffic < 40 ? 'quiet' : s.foot_traffic < 70 ? 'moderately busy' : 'busy';
+
+  parts.push(
+    `This stretch is ${lightWord} and ${trafficWord} during the ${s.time_bucket}, scoring ${s.safety_score} out of 100.`
+  );
+
+  const inc = s.incident_summary[0];
+  if (inc) {
+    if (s.corroborated) {
+      parts.push(
+        `${inc.count} independent reports here in the last ${inc.most_recent_days_ago <= 30 ? '30 days' : 'months'} (most recent ${inc.most_recent_days_ago} day${inc.most_recent_days_ago === 1 ? '' : 's'} ago, average severity ${inc.severity_avg}/3).`
+      );
+    } else {
+      parts.push(
+        `One unconfirmed report was logged ${inc.most_recent_days_ago} day${inc.most_recent_days_ago === 1 ? '' : 's'} ago; it has not been corroborated by another reporter.`
+      );
+    }
+    if (inc.sample_notes.length > 0) {
+      parts.push(`One reporter noted: "${inc.sample_notes[0]}"`);
+    }
+  }
+
+  return parts.join(' ');
+}
+
+// ── Renderer B: Python subprocess (real LLM) ─────────────────────────
+
+/**
+ * Call ai_agent/explain_agent.py over stdin/stdout.
+ *
+ * @param {object} signals
+ * @param {string} provider - mock | grok | gemini
+ * @returns {Promise<string>}
+ */
+export function renderExplanationPython(signals, provider = 'mock') {
+  return new Promise((resolve, reject) => {
+    const bin = process.env.PYTHON_BIN || 'python3';
+    const child = execFile(
+      bin,
+      [AGENT_SCRIPT, '--provider', provider],
+      { timeout: AGENT_TIMEOUT_MS, cwd: REPO_ROOT, maxBuffer: 1024 * 1024 },
+      (err, stdout, stderr) => {
+        if (err) return reject(new Error(stderr || err.message));
+        try {
+          const parsed = JSON.parse(stdout);
+          if (!parsed.explanation) return reject(new Error('agent returned no explanation'));
+          resolve(String(parsed.explanation).trim());
+        } catch (e) {
+          reject(e);
+        }
+      }
+    );
+    child.stdin.end(JSON.stringify(signals));
+  });
+}
+
+// ── Renderer C: deployed Python function over HTTP ───────────────────
+
+/**
+ * POST to the agent deployed from ai_agent/ (api/index.py). Contract:
+ *   request  { "signals": {...}, "provider": "gemini" }
+ *   response { "explanation": "..." }
+ *
+ * @param {object} signals
+ * @param {string} provider - mock | grok | gemini
+ * @returns {Promise<string>}
+ */
+export async function renderExplanationHttp(signals, provider = 'gemini') {
+  const url = process.env.EXPLAIN_AGENT_URL;
+  if (!url) throw new Error('EXPLAIN_AGENT_URL is not set');
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), AGENT_TIMEOUT_MS);
+  try {
+    const res = await fetch(url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ signals, provider }),
+      signal: controller.signal,
+    });
+    if (!res.ok) throw new Error(`agent HTTP ${res.status}`);
+    const body = await res.json();
+    if (!body.explanation) throw new Error(body.error || 'agent returned no explanation');
+    return String(body.explanation).trim();
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+// ── Public entry point ───────────────────────────────────────────────
+
+/**
+ * Produce an explanation for one route. Returns null on any failure so the
+ * caller's base contract is never at risk.
+ *
+ * @param {object} params - passed through to buildSignals
+ * @param {object} [deps] - { getDb }
+ * @returns {Promise<{ explanation: string, signals: object, mode: string } | null>}
+ */
+export async function explainRoute(params, deps = {}) {
+  try {
+    const signals = await buildSignals(params, deps);
+    const mode = process.env.EXPLAIN_AGENT_MODE || 'js';
+    const provider = process.env.EXPLAIN_AGENT_PROVIDER || DEFAULT_PROVIDER;
+
+    // Every remote mode degrades to the in-process renderer on failure, so a
+    // cold Python function or a dead LLM never costs you the explanation.
+    let explanation;
+    let usedMode = mode;
+    if (mode === 'python' || mode === 'http') {
+      try {
+        explanation =
+          mode === 'python'
+            ? await renderExplanationPython(signals, provider)
+            : await renderExplanationHttp(signals, provider);
+      } catch {
+        explanation = renderExplanationJs(signals);
+        usedMode = `${mode}-fallback-js`;
+      }
+    } else {
+      explanation = renderExplanationJs(signals);
+      usedMode = 'js';
+    }
+
+    return { explanation, signals, mode: usedMode };
+  } catch {
+    return null;
+  }
+}
+
+export default explainRoute;
