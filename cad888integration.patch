@@ -0,0 +1,39 @@
+/**
+ * Minimal forward geocoding via OpenStreetMap Nominatim.
+ *
+ * Nominatim's usage policy: max 1 request/second, and it wants a descriptive
+ * referrer/user agent. That's fine for a demo and for judging, but for anything
+ * beyond that, proxy it through the backend or swap in a paid geocoder.
+ */
+
+export type Place = { label: string; lat: number; lng: number }
+
+const NOMINATIM = 'https://nominatim.openstreetmap.org/search'
+
+export async function geocode(query: string, limit = 5): Promise<Place[]> {
+  const q = query.trim()
+  if (q.length < 3) return []
+
+  const url = `${NOMINATIM}?format=json&limit=${limit}&q=${encodeURIComponent(q)}`
+  const res = await fetch(url, { headers: { Accept: 'application/json' } })
+  if (!res.ok) throw new Error(`Geocode failed: ${res.status}`)
+
+  const rows: Array<{ display_name: string; lat: string; lon: string }> = await res.json()
+  return rows.map((r) => ({
+    label: r.display_name,
+    lat: Number(r.lat),
+    lng: Number(r.lon),
+  }))
+}
+
+/** Browser geolocation, promisified. Resolves null if denied or unavailable. */
+export function currentPosition(): Promise<{ lat: number; lng: number } | null> {
+  return new Promise((resolve) => {
+    if (!('geolocation' in navigator)) return resolve(null)
+    navigator.geolocation.getCurrentPosition(
+      (pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
+      () => resolve(null),
+      { enableHighAccuracy: true, timeout: 8000 }
+    )
+  })
+}
