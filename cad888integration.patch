diff --git a/backend/.env.example b/backend/.env.example
index e9ffcc6..402d596 100644
--- a/backend/.env.example
+++ b/backend/.env.example
@@ -19,3 +19,22 @@ CORS_ORIGIN=http://localhost:5173
 # RFC-007 Resilience & Deployment
 # When true, OSRM failures serve pre-scored static routes instead of 502
 STATIC_FALLBACK_ENABLED=true
+
+# --- Time buckets --------------------------------------------------------
+# Buckets are about how a street FEELS locally, so evaluate them in local time.
+# India Standard Time = 330. Leave unset/0 to keep the old UTC behaviour.
+TIME_BUCKET_UTC_OFFSET_MIN=330
+
+# --- Role 3 explanation agent -------------------------------------------
+# Attaches a grounded 1-2 sentence "explanation" to GET /api/explain-context.
+EXPLAIN_AGENT_ENABLED=true
+# js     = render in-process (works on Vercel serverless, no LLM)
+# http   = call the agent deployed from ai_agent/ (real LLM, backend stays on Vercel)
+# python = spawn ai_agent/explain_agent.py (needs Python on the host)
+EXPLAIN_AGENT_MODE=js
+# Required when EXPLAIN_AGENT_MODE=http - the ai_agent Vercel deployment URL:
+# EXPLAIN_AGENT_URL=https://cad888-agent.vercel.app/api
+# Only used when EXPLAIN_AGENT_MODE=python: mock | grok | gemini
+EXPLAIN_AGENT_PROVIDER=mock
+EXPLAIN_AGENT_TIMEOUT_MS=8000
+# PYTHON_BIN=python3
diff --git a/backend/src/agent/register.js b/backend/src/agent/register.js
new file mode 100644
index 0000000..59dda22
--- /dev/null
+++ b/backend/src/agent/register.js
@@ -0,0 +1,47 @@
+/**
+ * Registers the Role 3 Explainable Safety Agent as the explanation provider
+ * for GET /api/explain-context.
+ *
+ * Imported once from server.js. Enabled with EXPLAIN_AGENT_ENABLED=true so the
+ * agent can be switched off without touching code (e.g. if a demo host has no
+ * Python and you also want the JS renderer silenced).
+ *
+ * The provider is additive by contract: it only ever sets `explanation` and
+ * `explanationSource` on the response. It never modifies score, band, factors,
+ * or disclaimer, and any failure inside it is swallowed upstream.
+ */
+
+import { registerExplainProvider } from '../services/explainContext.js';
+import { explainRoute, worstCellOf } from '../services/explainAgent.js';
+
+const LABELS = ['Fastest', 'Balanced', 'Safest'];
+
+export function registerSafetyAgent() {
+  if (process.env.EXPLAIN_AGENT_ENABLED !== 'true') return false;
+
+  registerExplainProvider(async (result, internals = {}) => {
+    const { cells = [], cellScoreMap = new Map(), bucket = 'day', deps = {} } = internals;
+    if (cells.length === 0) return;
+
+    const { cell } = worstCellOf(cells, cellScoreMap);
+
+    const out = await explainRoute(
+      {
+        cell,
+        score: result.score,
+        bucket,
+        routeLabel: LABELS[result.routeIndex] || `Route ${result.routeIndex + 1}`,
+      },
+      deps
+    );
+
+    if (out) {
+      result.explanation = out.explanation;
+      result.explanationSource = out.mode; // "js" | "python"
+    }
+  });
+
+  return true;
+}
+
+export default registerSafetyAgent;
diff --git a/backend/src/config.js b/backend/src/config.js
index 0dfe820..84973d8 100644
--- a/backend/src/config.js
+++ b/backend/src/config.js
@@ -21,7 +21,10 @@ export function validateConfig(env) {
     supabaseServiceKey: env.SUPABASE_SERVICE_KEY,
     reportHashSalt: env.REPORT_HASH_SALT,
     port: Number(env.PORT || 3000),
-    corsOrigin: '*',
+    // Default '*' keeps deployed frontends unblocked without extra config;
+    // set CORS_ORIGIN to lock it down to one origin. (Hardcoding '*' here broke
+    // the U-004 config test, which asserts CORS_ORIGIN is honoured.)
+    corsOrigin: env.CORS_ORIGIN || '*',
     // OSRM routing engine (RFC-002). Defaults target the public demo server;
     // for the live demo run local Docker OSRM with the foot profile instead
     // (runbook in RFC-007) and override via env.
